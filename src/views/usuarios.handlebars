<div id="view-usuarios" class="card shadow-sm border-0">
  <header class="py-3">
    <h1 class="text-center">Listado de pacientes</h1>
  </header>

  <div class="card-header bg-primary text-white">
    <h5 class="mb-0">Pacientes registrados</h5>
  </div>

  <main class="container">
    <section>
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Foto</th>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Correo</th>
            <th>Observaciones</th>
            <th>Historial</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          {{#each usuarios}}
          <tr>
            <td>
              {{#if foto}}
                <img src="{{foto}}" alt="Foto de {{nombre}}" class="rounded-circle" width="40" height="40" style="object-fit: cover;">
              {{else}}
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width:40px; height:40px; font-size: 0.85rem;">
                  {{nombre.[0]}}{{apellido.[0]}}
                </div>
              {{/if}}
            </td>
            <th scope="row">{{id}}</th>
            <td>{{nombre}}</td>
            <td>{{apellido}}</td>
            <td>{{correo}}</td>
            <td>{{observaciones}}</td>
            <td>{{historial.length}} registro(s)</td>
            <td>
              <a class="btn btn-sm btn-outline-info" href="/usuarios/perfil/{{id}}">Ver</a>
              <a class="btn btn-sm btn-outline-warning" href="/usuarios/actualizar/{{id}}">Actualizar</a>
              <a class="btn btn-sm btn-outline-danger" href="/usuarios/eliminar/{{id}}" onclick="return confirm('¿Eliminar este paciente?');">Eliminar</a>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  </main>
</div>
