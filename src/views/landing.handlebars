<div id="view-landing">

    <!-- Hero -->
    <header class="bg-primary bg-gradient text-white py-5">
        <div class="container py-4">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg-7 text-center text-lg-start">
                    <img
                        src="/img/logo_medigest.png"
                        alt="MediGest Salud Digital"
                        class="mb-4"
                        style="max-height: 90px;"
                    >
                    <h1 class="display-5 fw-bold mb-3">
                        Gestión de pacientes, simple y centralizada
                    </h1>
                    <p class="lead opacity-75 mb-4">
                        MediGest es la plataforma interna para registrar pacientes, llevar su
                        historial clínico y mantener todo organizado en un solo lugar.
                    </p>
                    <div class="d-flex justify-content-center justify-content-lg-start gap-2 flex-wrap">
                        <a href="/login" class="btn btn-light btn-lg px-4 fw-semibold">
                            Iniciar sesión
                        </a>
                    </div>
                </div>

                {{#if totalPacientes}}
                <div class="col-12 col-lg-5 text-center">
                    <div class="bg-white bg-opacity-10 rounded-4 p-4 p-lg-5 border border-light border-opacity-25">
                        <div class="display-3 fw-bold">{{totalPacientes}}</div>
                        <div class="opacity-75">pacientes gestionados en el sistema</div>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </header>

    <!-- Features -->
    <main class="container py-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Todo lo que necesitas para llevar el registro clínico</h2>
            <p class="text-muted">Pensado para el equipo administrativo y clínico de la institución.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="fs-1 mb-3">🗂️</div>
                    <h5 class="fw-semibold">Fichas de paciente</h5>
                    <p class="text-muted mb-0">
                        Registra nombre, contacto y observaciones clínicas de cada paciente en segundos.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="fs-1 mb-3">🕓</div>
                    <h5 class="fw-semibold">Historial trazable</h5>
                    <p class="text-muted mb-0">
                        Cada creación, edición o cambio queda registrado automáticamente en el historial del paciente.
                    </p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card border-0 shadow-sm h-100 text-center p-4">
                    <div class="fs-1 mb-3">🖼️</div>
                    <h5 class="fw-semibold">Foto de perfil</h5>
                    <p class="text-muted mb-0">
                        Sube una foto de perfil por paciente para identificarlo rápido en el listado.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a href="/login" class="btn btn-primary btn-lg px-5">
                Acceder al panel
            </a>
        </div>
    </main>

</div>