<div id="view-perfil">
  <header class="py-3">
    <h1 class="text-center">Perfil Paciente</h1>
  </header>

  <main class="container">
    {{#if usuario}}
      <section class="card shadow-sm p-4">

        <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start gap-4 mb-4">
          <div class="text-center">
            {{#if usuario.foto}}
              <img
                src="{{usuario.foto}}"
                alt="Foto de {{usuario.nombre}}"
                class="rounded-circle border"
                width="120"
                height="120"
                style="object-fit: cover;"
                id="foto-perfil-preview"
              >
            {{else}}
              <div
                class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold border"
                style="width:120px; height:120px; font-size: 2rem;"
                id="foto-perfil-preview"
              >
                {{usuario.nombre.[0]}}{{usuario.apellido.[0]}}
              </div>
            {{/if}}

            <form id="form-upload-foto" class="mt-2" enctype="multipart/form-data">
              <input
                type="file"
                id="input-foto"
                name="foto"
                accept="image/jpeg,image/png,image/webp"
                class="form-control form-control-sm mb-2"
                required
              >
              <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                {{#if usuario.foto}}Cambiar foto{{else}}Subir foto{{/if}}
              </button>
            </form>
            <p id="foto-mensaje" class="small mt-1 mb-0"></p>
          </div>

          <div class="flex-grow-1">
            <p><strong>Nombre:</strong> {{usuario.nombre}}</p>
            <p><strong>Apellido:</strong> {{usuario.apellido}}</p>
            <p><strong>Correo:</strong> {{usuario.correo}}</p>
            <p class="mb-0"><strong>Observaciones:</strong> {{usuario.observaciones}}</p>
          </div>
        </div>

        <h5 class="mt-3">Historial de acciones</h5>
        {{#if usuario.historial}}
          <ul>
            {{#each usuario.historial}}
              <li>{{accion}} — {{detalle}}</li>
            {{/each}}
          </ul>
        {{else}}
          <p class="text-muted">Sin registros de historial.</p>
        {{/if}}
      </section>
    {{else}}
      <section>
        <p class="fs-2 fw-bold text-center">
          No existe ningún paciente con el id: {{id}}
        </p>
      </section>
    {{/if}}
  </main>
</div>

<script>
  // Módulo 8: subida de foto de perfil. Requiere JWT (misma cookie "token"
  // que usan crearUsuarios.handlebars y actualizarUsuario.handlebars).
  function obtenerTokenDeCookie() {
    const match = document.cookie.match(/(?:^|;\s*)token=([^;]+)/);
    return match ? decodeURIComponent(match[1]) : null;
  }

  const formUploadFoto = document.getElementById("form-upload-foto");

  if (formUploadFoto) {
    formUploadFoto.addEventListener("submit", async (event) => {
      event.preventDefault();

      const mensaje = document.getElementById("foto-mensaje");
      const inputFoto = document.getElementById("input-foto");

      if (!inputFoto.files.length) {
        mensaje.textContent = "Selecciona una imagen primero.";
        mensaje.className = "small mt-1 mb-0 text-danger";
        return;
      }

      const token = obtenerTokenDeCookie();
      if (!token) {
        alert("Tu sesión expiró. Vuelve a iniciar sesión.");
        window.location.href = "/login";
        return;
      }

      const formData = new FormData();
      formData.append("foto", inputFoto.files[0]);

      try {
        mensaje.textContent = "Subiendo...";
        mensaje.className = "small mt-1 mb-0 text-muted";

        // OJO: no seteamos "Content-Type" manualmente. El navegador arma
        // automáticamente el boundary correcto de multipart/form-data.
        const response = await fetch("/api/usuarios/{{id}}/foto", {
          method: "POST",
          headers: {
            "Authorization": "Bearer " + token
          },
          body: formData,
        });

        const data = await response.json();

        if (response.status === 401) {
          alert("Tu sesión expiró. Vuelve a iniciar sesión.");
          window.location.href = "/login";
          return;
        }

        if (!response.ok) {
          mensaje.textContent = data.message || "No se pudo subir la foto.";
          mensaje.className = "small mt-1 mb-0 text-danger";
          return;
        }

        mensaje.textContent = "Foto actualizada.";
        mensaje.className = "small mt-1 mb-0 text-success";

        // Refresca la página para mostrar la nueva foto ya persistida.
        setTimeout(() => location.reload(), 800);
      } catch (error) {
        console.error(error);
        mensaje.textContent = "Error de red al subir la foto.";
        mensaje.className = "small mt-1 mb-0 text-danger";
      }
    });
  }
</script>
