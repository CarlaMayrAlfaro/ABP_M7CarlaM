<div id="view-crear-usuario">

 <header class="py-4">
    <h1 class="text-center fw-bold text-primary mb-2">
        Crear nuevo paciente
    </h1>
    <p class="text-center text-muted mb-0">
        Registra los datos del paciente para incorporarlo al sistema
    </p>
</header>

<main class="container pb-5">

<section class="row justify-content-center">

    <div class="col-12 col-md-8 col-lg-6">

        <div class="card shadow-sm border-0">

            <!-- Encabezado -->
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0 text-center">
                    Datos del paciente
                </h5>
            </div>

            <!-- Formulario -->
            <div class="card-body p-4">

                <form id="form-create-usuario">

                    <!-- Nombre -->
                    <div class="mb-3">
                        <label for="nombre" class="form-label fw-semibold">
                            Nombre
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="nombre"
                            id="nombre"
                            placeholder="Ingresa el nombre"
                            required
                        >
                    </div>

                    <!-- Apellido -->
                    <div class="mb-3">
                        <label for="apellido" class="form-label fw-semibold">
                            Apellido
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            name="apellido"
                            id="apellido"
                            placeholder="Ingresa el apellido"
                            required
                        >
                    </div>

                    <!-- Correo -->
                    <div class="mb-4">
                        <label for="correo" class="form-label fw-semibold">
                            Correo electrónico
                        </label>

                        <input
                            type="email"
                            class="form-control"
                            name="correo"
                            id="correo"
                            placeholder="ejemplo@correo.com"
                            required
                        >

                        <div class="form-text">
                            Utiliza un correo electrónico válido.
                        </div>
                    </div>

                    <!-- Observaciones -->
                    <div class="mb-4">
                        <label for="observaciones" class="form-label fw-semibold">
                            Observaciones
                        </label>

                        <textarea
                            class="form-control"
                            name="observaciones"
                            id="observaciones"
                            rows="3"
                            placeholder="Ingresa observaciones (opcional)"
                        ></textarea>
                    </div>

                    <!-- Foto de perfil (opcional) -->
                    <div class="mb-4">
                        <label for="foto" class="form-label fw-semibold">
                            Foto de perfil
                        </label>

                        <input
                            type="file"
                            class="form-control"
                            name="foto"
                            id="foto"
                            accept="image/jpeg,image/png,image/webp"
                        >

                        <div class="form-text">
                            Opcional. JPG, PNG o WEBP, máximo 2MB. También puedes agregarla después desde el perfil del paciente.
                        </div>
                    </div>

                    <!-- Botones -->
                    <div class="d-flex justify-content-end gap-2">

                        <button
                            type="reset"
                            class="btn btn-outline-secondary">
                            Limpiar
                        </button>

                        <button
                            type="submit"
                            class="btn btn-primary px-4">
                            Crear paciente
                        </button>

                    </div>

                </form>

                <!-- Mensaje de éxito -->
                <div
                    class="alert alert-success d-none mt-4 mb-0"
                    role="alert"
                    id="alert-success">

                    Paciente creado con éxito.

                </div>

            </div>

        </div>

    </div>

</section>

</main>

</div>


<script>
    // Módulo 8: la API (/api/usuarios) ahora exige JWT.
    // El login web guarda el token en una cookie NO httpOnly ("token")
    // para que este script pueda leerlo y enviarlo como Bearer.
    function obtenerTokenDeCookie() {
        const match = document.cookie.match(/(?:^|;\s*)token=([^;]+)/);
        return match ? decodeURIComponent(match[1]) : null;
    }

    const formCreateUsuario = document.getElementById("form-create-usuario");

    formCreateUsuario.addEventListener("submit", async (event) => {
        try {
            event.preventDefault();

            // Obtener valores del formulario
            const nombre = document.getElementById("nombre").value.trim();
            const apellido = document.getElementById("apellido").value.trim();
            const correo = document.getElementById("correo").value.trim();
            const observaciones = document.getElementById("observaciones").value.trim();

            // Validar que no estén vacíos
            if (!nombre || !apellido || !correo) {
                alert("Por favor completa los campos obligatorios: nombre, apellido y correo");
                return;
            }

            const token = obtenerTokenDeCookie();
            if (!token) {
                alert("Tu sesión expiró. Vuelve a iniciar sesión.");
                window.location.href = "/login";
                return;
            }

            // Construir objeto - JSON.stringify maneja automáticamente saltos de línea
            const datos = {
                nombre: nombre,
                apellido: apellido,
                correo: correo,
                observaciones: observaciones // puede estar vacío, pero eso está bien
            };

            console.log("Datos a enviar:", datos);

            // JSON.stringify() escapa automáticamente caracteres especiales
            const jsonBody = JSON.stringify(datos);
            console.log("JSON a enviar:", jsonBody);

            const response = await fetch("/api/usuarios", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + token
                },
                body: jsonBody
            });

            const data = await response.json();
            console.log("Respuesta del servidor:", data);

            if (response.status === 201) {
                const alertSuccess = document.getElementById("alert-success");
                const usuarioId = data.data.id;

                // Si se seleccionó una foto, se sube justo después de crear
                // al paciente, reutilizando POST /api/usuarios/:id/foto.
                const inputFoto = document.getElementById("foto");
                let mensajeFinal = data.message;

                if (inputFoto.files.length > 0) {
                    const formDataFoto = new FormData();
                    formDataFoto.append("foto", inputFoto.files[0]);

                    try {
                        const fotoResponse = await fetch("/api/usuarios/" + usuarioId + "/foto", {
                            method: "POST",
                            headers: {
                                "Authorization": "Bearer " + token
                                // Sin "Content-Type": el navegador arma el boundary de multipart solo.
                            },
                            body: formDataFoto,
                        });

                        const fotoData = await fotoResponse.json();

                        if (!fotoResponse.ok) {
                            mensajeFinal += " (La foto no se pudo subir: " + (fotoData.message || "error desconocido") + ")";
                        }
                    } catch (fotoError) {
                        console.error("Error al subir la foto:", fotoError);
                        mensajeFinal += " (La foto no se pudo subir por un error de red.)";
                    }
                }

                alertSuccess.textContent = mensajeFinal;
                alertSuccess.classList.remove("d-none");

                formCreateUsuario.reset();

                setTimeout(() => {
                    location.href = "/usuarios/perfil/" + usuarioId;
                }, 2000);

            } else if (response.status === 401) {
                alert("Tu sesión expiró. Vuelve a iniciar sesión.");
                window.location.href = "/login";
            } else {
                alert("Error: " + (data.message || "No se pudo crear el paciente"));
            }

        } catch (error) {
            console.error("Error al crear paciente:", error);
            alert("Hubo un error al intentar crear el paciente: " + error.message);
        }
    });
</script>