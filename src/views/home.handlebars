<div id="view-home">

    <!-- Hero -->
    <header class="bg-primary bg-gradient text-white py-5 mb-4">
        <div class="container text-center">
            <img
                src="/img/logo_medigest.png"
                alt="MediGest Salud Digital"
                class="mb-1"
                style="max-height: 150px;"
            >
            <h1 class="fw-bold mb-2">Bienvenido a MediGest</h1>
            <p class="lead mb-4 opacity-75">
                Panel de gestión de pacientes — visualiza el estado general del sistema.
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a href="/crear-usuarios" class="btn btn-light btn-lg px-4 fw-semibold">
                    + Nuevo paciente
                </a>
                <a href="/usuarios" class="btn btn-outline-light btn-lg px-4">
                    Ver todos los pacientes
                </a>
            </div>
        </div>
    </header>

    <main class="container pb-5">

        <!-- Tarjetas de estadísticas -->
        <section class="row g-3 mb-5">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold text-primary">{{stats.totalPacientes}}</div>
                        <div class="text-muted small">Pacientes totales</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold text-primary">{{stats.totalConFoto}}</div>
                        <div class="text-muted small">Con foto de perfil</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold text-primary">{{stats.porcentajeConFoto}}%</div>
                        <div class="text-muted small">Cobertura de fotos</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100 text-center">
                    <div class="card-body">
                        <div class="fs-2 fw-bold text-primary">{{stats.totalHistorial}}</div>
                        <div class="text-muted small">Registros en historial</div>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">

            <!-- Pacientes recientes -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="mb-0">Pacientes recientes</h5>
                    </div>
                    <div class="card-body pt-0">
                        {{#if pacientesRecientes.length}}
                            <ul class="list-group list-group-flush">
                                {{#each pacientesRecientes}}
                                <li class="list-group-item d-flex align-items-center gap-3 px-0">
                                    {{#if foto}}
                                        <img src="{{foto}}" alt="Foto de {{nombre}}" class="rounded-circle" width="40" height="40" style="object-fit: cover;">
                                    {{else}}
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width:40px; height:40px; font-size: 0.85rem;">
                                            {{nombre.[0]}}{{apellido.[0]}}
                                        </div>
                                    {{/if}}
                                    <div class="flex-grow-1">
                                        <a href="/usuarios/perfil/{{id}}" class="fw-semibold text-decoration-none">{{nombre}} {{apellido}}</a>
                                        <div class="text-muted small">{{correo}}</div>
                                    </div>
                                    <span class="text-muted small">{{fechaFormateada}}</span>
                                </li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class="text-muted text-center py-4 mb-0">
                                Aún no hay pacientes registrados.
                                <a href="/crear-usuarios">Crea el primero</a>.
                            </p>
                        {{/if}}
                    </div>
                </div>
            </div>

            <!-- Actividad reciente -->
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 pt-3">
                        <h5 class="mb-0">Actividad reciente</h5>
                    </div>
                    <div class="card-body pt-0">
                        {{#if actividadReciente.length}}
                            <ul class="list-group list-group-flush">
                                {{#each actividadReciente}}
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between">
                                        <span class="badge bg-primary-subtle text-primary-emphasis fw-semibold">{{accion}}</span>
                                        <span class="text-muted small">{{fechaFormateada}}</span>
                                    </div>
                                    <p class="mb-0 mt-1 small">{{detalle}}</p>
                                    {{#if usuario}}
                                        <a href="/usuarios/perfil/{{usuario.id}}" class="small text-decoration-none">
                                            Ver paciente: {{usuario.nombre}} {{usuario.apellido}}
                                        </a>
                                    {{/if}}
                                </li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class="text-muted text-center py-4 mb-0">
                                Todavía no hay actividad registrada.
                            </p>
                        {{/if}}
                    </div>
                </div>
            </div>

        </div>

    </main>

</div>